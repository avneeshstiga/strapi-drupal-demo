{
  "kind": "collectionType",
  "collectionName": "member_types",
  "info": {
    "singularName": "member-type",
    "pluralName": "member-types",
    "displayName": "Member Type",
    "description": "Drupal taxonomy: Member Type"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "blocks"
    },
    "languages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::language.language"
    },
    "url_alias": {
      "type": "string",
      "unique": true
    },
    "drupal_id": {
      "type": "string"
    }
  }
}

      "required": true
    },
    "description": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "drupal_id": {
      "type": "string",
      "unique": true
    },
    "default_langcode": {
      "type": "boolean"
    },
    "drupal_langcode": {
      "type": "string"
    },
    "weight": {
      "type": "integer"
    },
    "drupal_internal__tid": {
      "type": "integer"
    },
    "path": {
      "type": "json"
    }

{
  "kind": "collectionType",
  "collectionName": "domains",
  "info": {
    "singularName": "domain",
    "pluralName": "domains",
    "displayName": "Domain",
    "description": "Domain configuration for multi-site management"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "hostname": {
      "type": "string",
      "required": true
    },
    "machine_name": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "scheme": {
      "type": "enumeration",
      "enum": ["http", "https", "variable"],
      "default": "http",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "inactive"],
      "default": "active",
      "required": true
    },
    "weight": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 999
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "test_server_response": {
      "type": "boolean",
      "default": true
    },
    "bjp_uuid": {
      "type": "string",
      "description": "BJP API UUID for synchronization"
    },
    "user_access": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-admin.user-admin",
      "inversedBy": "domain_access"
    },
    "user_admin": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-admin.user-admin",
      "inversedBy": "domain_admin"
    }
  }
}

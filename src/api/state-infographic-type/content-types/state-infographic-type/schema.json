{
  "kind": "collectionType",
  "collectionName": "state_infographic_types",
  "info": {
    "singularName": "state-infographic-type",
    "pluralName": "state-infographic-types",
    "displayName": "State Infographic Type",
    "description": "Types of state-level infographics and their metadata"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "drupal_id": {
      "type": "string",
      "unique": true
    },
    "drupal_internal__tid": {
      "type": "integer"
    },
    "drupal_langcode": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 160,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "description": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "weight": {
      "type": "integer"
    },
    "order": {
      "type": "integer"
    },
    "default_langcode": {
      "type": "boolean"
    },
    "taxonomy_pim_id": {
      "type": "string"
    },
    "infographics_image": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "photography_infography_img": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "path": {
      "type": "json"
    },
    "redirect_url": {
      "type": "json"
    }
  }
}

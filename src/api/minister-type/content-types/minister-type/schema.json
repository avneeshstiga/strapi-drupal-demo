{
  "kind": "collectionType",
  "collectionName": "minister_types",
  "info": {
    "singularName": "minister-type",
    "pluralName": "minister-types",
    "displayName": "Minister Type",
    "description": "Taxonomy to categorize types of ministers"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
   "languages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::language.language"
    },
    "name": {
      "type": "string",
      "required": true
    },
   "description": {
      "type": "blocks"
    },
    "default_langcode": {
      "type": "boolean"
    },
    "url_alias": {
      "type": "string",
      "unique": true
    },
    "drupal_id": {
      "type": "string"
    }
  }
}

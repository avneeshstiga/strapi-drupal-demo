{
  "kind": "collectionType",
  "collectionName": "time_durations",
  "info": {
    "singularName": "time-duration",
    "pluralName": "time-durations",
    "displayName": "Time Duration",
    "description": "Time duration taxonomy from Drupal"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "languages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::language.language"
    },
    "description": {
      "type": "blocks"
    },
    "url_alias": {
      "type": "string",
      "unique": true
    },
    "drupal_id": {
      "type": "string"
    }
  }  
}

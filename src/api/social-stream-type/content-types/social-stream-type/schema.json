{
  "kind": "collectionType",
  "collectionName": "social_stream_types",
  "info": {
    "singularName": "social-stream-type",
    "pluralName": "social-stream-types",
    "displayName": "Social Stream Type",
    "description": "Types of social media streams like Facebook, Twitter, etc."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "languages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::language.language"
    },
    "description": {
      "type": "blocks"
    },
    "default_langcode": {
      "type": "boolean"
    },
    "field_social_stream_icon": {
      "type": "string"
    },
    "url_alias": {
      "type": "string",
      "unique": true
    },
    "drupal_id": {
      "type": "string"
    }
  }
}

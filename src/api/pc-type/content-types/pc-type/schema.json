{
  "kind": "collectionType",
  "collectionName": "pc_types",
  "info": {
    "singularName": "pc-type",
    "pluralName": "pc-types",
    "displayName": "PC Type",
    "description": "Parliamentary constituency types with optional state reference"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "default_langcode": {
      "type": "boolean"
    },
    "taxonomy_pim_id": {
      "type": "string"
    },
    "state": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::state.state",
      "inversedBy": "pc_types"
    },
    "url_alias": {
      "type": "string",
      "unique": true
    },
    "drupal_id": {
      "type": "string",
      "unique": true
    },
    "drupal_internal__tid": {
      "type": "integer"
    },
    "drupal_langcode": {
      "type": "string"
    },
    "weight": {
      "type": "integer"
    }
  }
}

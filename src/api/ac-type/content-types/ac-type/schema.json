{
  "kind": "collectionType",
  "collectionName": "ac_types",
  "info": {
    "singularName": "ac-type",
    "pluralName": "ac-types",
    "displayName": "AC Type",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 60
    },
    "languages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::language.language"
    },
    "url_alias": {
      "type": "string"
    },
    "drupal_id": {
      "type": "string"
    },
    "taxonomy_pim_id": {
      "type": "string",
      "maxLength": 60
    },
    "drupal_published": {
      "type": "boolean"
    },
    "description": {
      "type": "blocks"
    },
    "state": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::state.state",
      "inversedBy": "ac_types"
    },
    "state_highlight": {
      "type": "component",
      "repeatable": false,
      "component": "shared.highlight-state",
      "required": true
    }
  }
}

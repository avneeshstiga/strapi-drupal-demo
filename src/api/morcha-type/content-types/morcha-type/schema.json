{
  "kind": "collectionType",
  "collectionName": "morcha_types",
  "info": {
    "singularName": "morcha-type",
    "pluralName": "morcha-types",
    "displayName": "Morcha Type",
    "description": "Types of Morcha such as Kisan Morcha"
  },

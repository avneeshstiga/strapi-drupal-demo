      "target": "api::language.language"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "blocks"
    },
    "default_langcode": {
      "type": "boolean"
    },
    "url_alias": {
      "type": "string",
      "unique": true
    },
    "drupal_id": {
      "type": "string"
    }
  }
}
